<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.htnhome.timoremote.robot">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <queries><package android:name="com.csjbot.robotsdk.ten"/></queries>
    <application android:label="Timo Remote Robot" android:allowBackup="false" android:usesCleartextTraffic="true" android:icon="@android:drawable/ic_menu_compass" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:configChanges="keyboardHidden|orientation|screenSize"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <service android:name="com.csjbot.coshandler.service.HandlerMsgService" android:exported="true"/>
        <receiver android:name=".SetupReceiver" android:exported="true" android:permission="android.permission.DUMP"/>
    </application>
</manifest>
